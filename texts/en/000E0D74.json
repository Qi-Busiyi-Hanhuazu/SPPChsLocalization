  {
    "index": 2,
    "key": "000E0D74_0002",
    "original": "[1:00110000000001][1:00110100000008]\n...for Vibe Island is\nsaid to hold great power.[1:0002b4]\n[1:00110200000001][1:000101]",
    "translation": "[1:00110000000001][1:00110100000008]\n...for Vibe Island is\nsaid to hold great power.[1:0002b4]\n[1:00110200000001][1:000101]"
  },
  {
    "index": 3,
    "key": "000E0D74_0003",
    "original": "[1:00110000000001][1:00110100000009]\nBowser heard of it and\nbuilt a summer villa\nthere...[1:0002b4]\n[1:000101]",
