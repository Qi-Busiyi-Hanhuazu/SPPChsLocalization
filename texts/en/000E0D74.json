    "index": 0,
    "key": "000E0D74_0000",
    "original": "[1:00110000000001][1:00110100000008]\nThis is mysterious\nVibe Island.\n[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000001][1:00110100000008]\nThis is mysterious\nVibe Island.\n[1:0002b4]\n[1:000101]"
  },
  {
    "index": 1,
    "key": "000E0D74_0001",
