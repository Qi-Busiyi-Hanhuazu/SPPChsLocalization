[
  {
    "index": 0,
    "key": "000D4254_0000",
    "original": "[1:000e03]\nUse this move on the water!\nYou can't attack, so avoid\nyour enemies by jumping!\n[1:000e01]",
    "translation": "[1:000e03]\nUse this move on the water!\nYou can't attack, so avoid\nyour enemies by jumping!\n[1:000e01]"
  },
  {
    "index": 1,
    "key": "000D4254_0001",
    "original": "[1:000e03]\nStrike low-lying foes and\ncrush blocks to move on!\n[1:000e01]",
    "translation": "[1:000e03]\nStrike low-lying foes and\ncrush blocks to move on!\n[1:000e01]"
  },
  {
    "index": 2,
    "key": "000D4254_0002",
    "original": "[1:000e03]\nWhile sliding, strike \nfoes that get in your way!\n[1:000e01]",
    "translation": "[1:000e03]\nWhile sliding, strike \nfoes that get in your way!\n[1:000e01]"
  },
  {
    "index": 3,
    "key": "000D4254_0003",
    "original": "[1:000e03]\nYour umbrella will float for\na bit and allow you to fly!\n[1:000e01]",
    "translation": "[1:000e03]\nYour umbrella will float for\na bit and allow you to fly!\n[1:000e01]"
  },
  {
    "index": 4,
    "key": "000D4254_0004",
    "original": "[1:000e03]\nUse this move on ropes!\nYou can't attack, but you\ncan beat foes by jumping!\n[1:000e01]",
    "translation": "[1:000e03]\nUse this move on ropes!\nYou can't attack, but you\ncan beat foes by jumping!\n[1:000e01]"
  },
  {
    "index": 5,
    "key": "000D4254_0005",
    "original": "[1:000e03]\nUse this move in the water!\nBlow into the mic to send\nair bubbles out!\n[1:000e01]",
    "translation": "[1:000e03]\nUse this move in the water!\nBlow into the mic to send\nair bubbles out!\n[1:000e01]"
  },
  {
    "index": 6,
    "key": "000D4254_0006",
    "original": "[1:000e03]\nCause an earthquake when\nyou hit the floor, stunning\nnearby ground-bound foes!\n[1:000e01]",
    "translation": "[1:000e03]\nCause an earthquake when\nyou hit the floor, stunning\nnearby ground-bound foes!\n[1:000e01]"
  },
  {
    "index": 7,
    "key": "000D4254_0007",
    "original": "[1:000e03]\nA projectile weapon for your\numbrella! Strike elusive\nenemies from afar!\n[1:000e01]",
    "translation": "[1:000e03]\nA projectile weapon for your\numbrella! Strike elusive\nenemies from afar!\n[1:000e01]"
  },
  {
    "index": 8,
    "key": "000D4254_0008",
    "original": "[1:000e03]\nSpeed along while blasting\nyour enemies! \n[1:000e01]",
    "translation": "[1:000e03]\nSpeed along while blasting\nyour enemies! \n[1:000e01]"
  },
  {
    "index": 9,
    "key": "000D4254_0009",
    "original": "test",
    "translation": "test"
  },
  {
    "index": 10,
    "key": "000D4254_0010",
    "original": "_Dashbrella unlocked!\n_NEW STAGES added to area 1!\n  Defeat each area's boss to\n  open NEW STAGES! They get\n  harder, so good luck!\n  Clear all minigame levels\n  and puzzles for a gift...",
    "translation": "_Dashbrella unlocked!\n_NEW STAGES added to area 1!\n  Defeat each area's boss to\n  open NEW STAGES! They get\n  harder, so good luck!\n  Clear all minigame levels\n  and puzzles for a gift..."
  },
