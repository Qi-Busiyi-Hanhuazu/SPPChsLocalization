  {
    "index": 59,
    "key": "000D4254_0059",
    "original": "[1:000e03]\nMove with\nleft/right.\n[5:000103]   @jump.\n[1:000e01]",
    "translation": "[1:000e03]\nMove with\nleft/right.\n[5:000103]   @jump.\n[1:000e01]"
  },
  {
    "index": 60,
    "key": "000D4254_0060",
    "original": "[1:000e03]\nRun and\nsquat.\n[1:000e01]",
    "translation": "[1:000e03]\nRun and\nsquat.\n[1:000e01]"
  },
  {
    "index": 61,
    "key": "000D4254_0061",
    "original": "[1:000e03]\nSquat on a\nhill.\n[1:000e01]",
    "translation": "[1:000e03]\nSquat on a\nhill.\n[1:000e01]"
  },
  {
    "index": 62,
    "key": "000D4254_0062",
    "original": "[1:000e03]\nHold [5:000103]   \nwhile\njumping.\n[1:000e01]",
    "translation": "[1:000e03]\nHold [5:000103]   \nwhile\njumping.\n[1:000e01]"
  },
  {
    "index": 63,
    "key": "000D4254_0063",
    "original": "[1:000e03]\nLeft/right\nfor speed.\n[5:000103]   @jump.\n[1:000e01]",
    "translation": "[1:000e03]\nLeft/right\nfor speed.\n[5:000103]   @jump.\n[1:000e01]"
  },
  {
    "index": 64,
    "key": "000D4254_0064",
    "original": "[1:000e03]\nMove with\nleft/right.\n[5:000103]   @float.\n[1:000e01]",
    "translation": "[1:000e03]\nMove with\nleft/right.\n[5:000103]   @float.\n[1:000e01]"
  },
  {
    "index": 65,
    "key": "000D4254_0065",
    "original": "[1:000e03]\nPress\ndown + [5:000104]   \nmid-jump!\n[1:000e01]",
    "translation": "[1:000e03]\nPress\ndown + [5:000104]   \nmid-jump!\n[1:000e01]"
  },
  {
    "index": 66,
    "key": "000D4254_0066",
    "original": "[1:000e03]\nHold [5:000104]   \nand then\nrelease.\n[1:000e01]",
    "translation": "[1:000e03]\nHold [5:000104]   \nand then\nrelease.\n[1:000e01]"
  },
  {
    "index": 67,
    "key": "000D4254_0067",
    "original": "[1:000e03]\nPress [5:000104]   \nrepeatedly\nas you run.\n[1:000e01]",
    "translation": "[1:000e03]\nPress [5:000104]   \nrepeatedly\nas you run.\n[1:000e01]"
  },
