[
  {
    "index": 0,
    "key": "000E92D4_0000",
    "original": "テキを　持ち上げたじょうたいで\nしゃがむと　オイラがテキを\nくっちまうカサー！\n[1:000300][1:000100]\nこれで\n喜怒哀楽ゲージ[5:00010c]　　　　　が\n少しかいふくするんだカサー！\n",
    "translation": "テキを　持ち上げたじょうたいで\nしゃがむと　オイラがテキを\nくっちまうカサー！\n[1:000300][1:000100]\nこれで\n喜怒哀楽ゲージ[5:00010c]　　　　　が\n少しかいふくするんだカサー！\n"
  },
  {
    "index": 1,
    "key": "000E92D4_0001",
    "original": "[5:000100]　　で　ダッシュ！\n[5:000103]　　で　ジャンプ！\n[5:000104]　　か[5:000106]　　で　こうげき！\n[1:000300][1:000100]\nほとんどのテキは　ジャンプで\nふんだり　こうげきで\nたたいたりで　たおせるカサー！\n[1:000300][1:000100]\n[5:000107]　　[5:000108]　　おしながら[5:000100]　　で\nゆっくり歩けるカサー！\n",
    "translation": "[5:000100]　　で　ダッシュ！\n[5:000103]　　で　ジャンプ！\n[5:000104]　　か[5:000106]　　で　こうげき！\n[1:000300][1:000100]\nほとんどのテキは　ジャンプで\nふんだり　こうげきで\nたたいたりで　たおせるカサー！\n[1:000300][1:000100]\n[5:000107]　　[5:000108]　　おしながら[5:000100]　　で\nゆっくり歩けるカサー！\n"
  },
  {
    "index": 2,
    "key": "000E92D4_0002",
    "original": "喜怒哀楽ゲージ[5:00010c]　　　　　は\nクリスタル[5:00010a]　　を\nとると　かいふくするカサー！\n[1:000300][1:000100]\n[5:00010a]　　は　ブロックを\nこわしたり　モノを投げて　テキを\nたおしたりすると出るカサー！\n",
    "translation": "喜怒哀楽ゲージ[5:00010c]　　　　　は\nクリスタル[5:00010a]　　を\nとると　かいふくするカサー！\n[1:000300][1:000100]\n[5:00010a]　　は　ブロックを\nこわしたり　モノを投げて　テキを\nたおしたりすると出るカサー！\n"
  },
  {
    "index": 3,
    "key": "000E92D4_0003",
    "original": "コイン[5:000116]　　は　あつめると\nおみせでかいものができるカサ！\n[1:000300][1:000100]\nハート[5:000109]　　は\nＨＰ[5:00010b]　　　　　が　かいふく！\nどちらも　見つけたら\nとれとれカサー！\n",
    "translation": "コイン[5:000116]　　は　あつめると\nおみせでかいものができるカサ！\n[1:000300][1:000100]\nハート[5:000109]　　は\nＨＰ[5:00010b]　　　　　が　かいふく！\nどちらも　見つけたら\nとれとれカサー！\n"
  },
  {
    "index": 4,
    "key": "000E92D4_0004",
    "original": "『喜』のアクション\n『たつまき』になるカサー！\n[5:000103]　　で　ふわふわとぶ\n（おしっぱなしかのう）\n高い所へ　ひとっとび！\n[1:000300][1:000100]\n『怒』のアクション\n『火』になるカサー！\nいろいろ　もやせカサー\n[5:000103]　　で　ジャンプ！\n",
    "translation": "『喜』のアクション\n『たつまき』になるカサー！\n[5:000103]　　で　ふわふわとぶ\n（おしっぱなしかのう）\n高い所へ　ひとっとび！\n[1:000300][1:000100]\n『怒』のアクション\n『火』になるカサー！\nいろいろ　もやせカサー\n[5:000103]　　で　ジャンプ！\n"
  },
  {
    "index": 5,
    "key": "000E92D4_0005",
    "original": "『哀』のアクション\n大泣きになるカサー！\nいろんなものに　『水』を\nかけてみるカサー\n[5:000103]　　で　ジャンプ！\n[1:000300][1:000100]\n『楽』のアクション\nＨＰ[5:00010b]　　　　　が　かいふく！\nじかんとともに[5:00010b]　　　　　が\nじょじょにかいふくするカサ！\n",
    "translation": "『哀』のアクション\n大泣きになるカサー！\nいろんなものに　『水』を\nかけてみるカサー\n[5:000103]　　で　ジャンプ！\n[1:000300][1:000100]\n『楽』のアクション\nＨＰ[5:00010b]　　　　　が　かいふく！\nじかんとともに[5:00010b]　　　　　が\nじょじょにかいふくするカサ！\n"
  },
  {
    "index": 6,
    "key": "000E92D4_0006",
    "original": "知ってるカサ？\nスヤスヤねむっている\n『楽』じょうたいのテキは・・\n[1:000300][1:000100]\n[5:000107]　　[5:000108]　　おしながら\n[5:000100]　　の『歩く』で\nおこさずにやりすごせるカサー\nそーっとちかづいて\nせんせいこうげきもできるカサ！\n",
    "translation": "知ってるカサ？\nスヤスヤねむっている\n『楽』じょうたいのテキは・・\n[1:000300][1:000100]\n[5:000107]　　[5:000108]　　おしながら\n[5:000100]　　の『歩く』で\nおこさずにやりすごせるカサー\nそーっとちかづいて\nせんせいこうげきもできるカサ！\n"
  },
  {
    "index": 7,
    "key": "000E92D4_0007",
    "original": "テキを　ジャンプでふんで\nひっくりかえらせ　ふれると\n持ち上げるカサー\n[1:000300][1:000100]\nそのまま[5:000104]　　か[5:000106]　　で\n放り投げるカサ！\n[1:000300][1:000100]\n[5:000105]　　は\nひっくりかえさなくても\n持ち上げられるカサー\n",
    "translation": "テキを　ジャンプでふんで\nひっくりかえらせ　ふれると\n持ち上げるカサー\n[1:000300][1:000100]\nそのまま[5:000104]　　か[5:000106]　　で\n放り投げるカサ！\n[1:000300][1:000100]\n[5:000105]　　は\nひっくりかえさなくても\n持ち上げられるカサー\n"
  },
  {
    "index": 8,
    "key": "000E92D4_0008",
    "original": "なんか　今にもくずれそうな\nアシバがあるカサねー\nしんどうあたえたら\nおちちゃいそうだから・・\n[1:000300][1:000100]\nゆっくりのって[5:000112]　　[5:000113]\nおしながら[5:000100]　　で\nそーっと歩くカサー\n",
    "translation": "なんか　今にもくずれそうな\nアシバがあるカサねー\nしんどうあたえたら\nおちちゃいそうだから・・\n[1:000300][1:000100]\nゆっくりのって[5:000112]　　[5:000113]\nおしながら[5:000100]　　で\nそーっと歩くカサー\n"
  },
  {
    "index": 9,
    "key": "000E92D4_0009",
    "original": "キノピオたちは\n各ステージ　３かしょずつに\nとらわれているから\nステージを　くまなくさがして\nみんな　みつけてあげるカサ\n[1:000300][1:000100]\nキノピオの　入っているハコは\nこうげきでこわして\nあげるカサー\n",
    "translation": "キノピオたちは\n各ステージ　３かしょずつに\nとらわれているから\nステージを　くまなくさがして\nみんな　みつけてあげるカサ\n[1:000300][1:000100]\nキノピオの　入っているハコは\nこうげきでこわして\nあげるカサー\n"
  },
  {
    "index": 10,
    "key": "000E92D4_0010",
    "original": "下がめんの　４スミの\nハートパネルをタッチすると\nピーチひめさまの　気分が\nかわるカサー！\n[1:000300][1:000100]\n４つの　気分のことを\n『喜怒哀楽（キドアイラク）』\nって　いうんだカサー！\n[1:000300][1:000100]\n『喜（キ）』は　よろこぶ\n『怒（ド）』は　おこる\n『哀（アイ）』は　かなしむ\n『楽（ラク）』は　たのしむ",
    "translation": "下がめんの　４スミの\nハートパネルをタッチすると\nピーチひめさまの　気分が\nかわるカサー！\n[1:000300][1:000100]\n４つの　気分のことを\n『喜怒哀楽（キドアイラク）』\nって　いうんだカサー！\n[1:000300][1:000100]\n『喜（キ）』は　よろこぶ\n『怒（ド）』は　おこる\n『哀（アイ）』は　かなしむ\n『楽（ラク）』は　たのしむ"
  },
  {
    "index": 11,
    "key": "000E92D4_0011",
    "original": "ダッシュ中　しゃがむと\nスライディング！\nスライディングは\nせまいばしょも通れるカサー\n",
    "translation": "ダッシュ中　しゃがむと\nスライディング！\nスライディングは\nせまいばしょも通れるカサー\n"
  },
  {
    "index": 12,
    "key": "000E92D4_0012",
    "original": "この先に　おかしなキノコと\nおはながあるカサー\nキノコとおはなの色には\nなにか　かんけいが・・？\n[1:000300][1:000100]\nキノコが　じゅんばんに\nピョンピョンして\nいるのも気になるカサー\n",
    "translation": "この先に　おかしなキノコと\nおはながあるカサー\nキノコとおはなの色には\nなにか　かんけいが・・？\n[1:000300][1:000100]\nキノコが　じゅんばんに\nピョンピョンして\nいるのも気になるカサー\n"
  },
  {
    "index": 13,
    "key": "000E92D4_0013",
    "original": "ム？　なんだか　もろそうな\nつりばしがあるカサー\nもえちゃいそうだから\nつりばしの上では\n『怒』っちゃダメカサー\n",
    "translation": "ム？　なんだか　もろそうな\nつりばしがあるカサー\nもえちゃいそうだから\nつりばしの上では\n『怒』っちゃダメカサー\n"
  },
  {
    "index": 14,
    "key": "000E92D4_0014",
    "original": "え？　ふつうに\nわたったらおちちゃう？\nそういうときは　思いっきり\nはやくダッシュできるほうほうを\nかんがえてみるカサー！\n[1:000300][1:000100]\nとにかく　『喜怒哀楽』\n色々ためしてみるカサー！\n",
    "translation": "え？　ふつうに\nわたったらおちちゃう？\nそういうときは　思いっきり\nはやくダッシュできるほうほうを\nかんがえてみるカサー！\n[1:000300][1:000100]\nとにかく　『喜怒哀楽』\n色々ためしてみるカサー！\n"
  },
  {
    "index": 15,
    "key": "000E92D4_0015",
    "original": "なんだか　あやしい\nモクモクがいるカサねー\nくもで　できてるみたい\nだから　『たつまき』を\nおこしたら　ちってしまうかも？\n[1:000300][1:000100]\nとにかく　あやしいものを\nみつけたら　『喜怒哀楽』\n色々ためしてみるカサー！\n",
    "translation": "なんだか　あやしい\nモクモクがいるカサねー\nくもで　できてるみたい\nだから　『たつまき』を\nおこしたら　ちってしまうかも？\n[1:000300][1:000100]\nとにかく　あやしいものを\nみつけたら　『喜怒哀楽』\n色々ためしてみるカサー！\n"
  },
  {
    "index": 16,
    "key": "000E92D4_0016",
    "original": "え？　へんなコウモリが\nいっぱいいて　とおれない？\nたしかコウモリは　『火』に\nよわいはずだったカサー\n",
    "translation": "え？　へんなコウモリが\nいっぱいいて　とおれない？\nたしかコウモリは　『火』に\nよわいはずだったカサー\n"
  },
  {
    "index": 17,
    "key": "000E92D4_0017",
    "original": "ところで知ってるカサ？\n下がめんの　ピーチひめさまは\n今いる　へやの中に　キノピオや\nだいじなアイテムがあると・・\n[1:000300][1:000100]\nそのへやに入ったしゅんかんに\n『！』マークを出して\n知らせるカサー！\nたまには　下がめんも\nチェックして・・\n[1:000300][1:000100]\n『！』が出ていたら\nそのへやの中を　くまなく\nさがしてみるカサー",
    "translation": "ところで知ってるカサ？\n下がめんの　ピーチひめさまは\n今いる　へやの中に　キノピオや\nだいじなアイテムがあると・・\n[1:000300][1:000100]\nそのへやに入ったしゅんかんに\n『！』マークを出して\n知らせるカサー！\nたまには　下がめんも\nチェックして・・\n[1:000300][1:000100]\n『！』が出ていたら\nそのへやの中を　くまなく\nさがしてみるカサー"
  },
  {
    "index": 18,
    "key": "000E92D4_0018",
    "original": "ゲホゲホ・・\nえ？どうしたかって？\nさっき　このむこうで\nひどいけむりにあったカサ・・\n[1:000300][1:000100]\n時間がたつとダメージを\nくらってしまうから・・\nはやく　『たつまき』か　なにか\nかぜをおこしてふきけすカサー！\n",
    "translation": "ゲホゲホ・・\nえ？どうしたかって？\nさっき　このむこうで\nひどいけむりにあったカサ・・\n[1:000300][1:000100]\n時間がたつとダメージを\nくらってしまうから・・\nはやく　『たつまき』か　なにか\nかぜをおこしてふきけすカサー！\n"
  },
  {
    "index": 19,
    "key": "000E92D4_0019",
    "original": "え？　へんなかおの　いわが\nとおせんぼしてる？\nヤツの上で　『怒』って\nドシンドシンしていたら・・\n[1:000300][1:000100]\nびっくりして\nとおしてくれるかも\nしれないカサー\n",
    "translation": "え？　へんなかおの　いわが\nとおせんぼしてる？\nヤツの上で　『怒』って\nドシンドシンしていたら・・\n[1:000300][1:000100]\nびっくりして\nとおしてくれるかも\nしれないカサー\n"
  },
  {
    "index": 20,
    "key": "000E92D4_0020",
    "original": "　　　タッチペンで　あしばをのばして\n　　　　　ピーチをジャンプさせ\n　　　　　上を　めざしましょう！\n　　　　　　スタートしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）",
    "translation": "　　　タッチペンで　あしばをのばして\n　　　　　ピーチをジャンプさせ\n　　　　　上を　めざしましょう！\n　　　　　　スタートしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）"
  },
  {
    "index": 21,
    "key": "000E92D4_0021",
    "original": "　　タッチペンであしばを回し　ピーチが\n　　　しょうがいぶつにあたらないように\n　　　　　上を　めざしましょう！\n　　　　　　スタートしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）\n",
    "translation": "　　タッチペンであしばを回し　ピーチが\n　　　しょうがいぶつにあたらないように\n　　　　　上を　めざしましょう！\n　　　　　　スタートしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）\n"
  },
  {
    "index": 22,
    "key": "000E92D4_0022",
    "original": "　　タッチペンで　下がめんにあらわれる\n　　テレサをこすってけしながら　ピーチを\n　　下まで　たどりつかせましょう！\n　　　　　　スタートしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）\n",
    "translation": "　　タッチペンで　下がめんにあらわれる\n　　テレサをこすってけしながら　ピーチを\n　　下まで　たどりつかせましょう！\n　　　　　　スタートしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）\n"
  },
  {
    "index": 23,
    "key": "000E92D4_0023",
    "original": "　　タッチペンで　下がめんにあらわれる\n　　しょうがいぶつをたたいてこわしながら\n　　ピーチを下までたどりつかせましょう！\n　　　　　　スタートしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）\n",
    "translation": "　　タッチペンで　下がめんにあらわれる\n　　しょうがいぶつをたたいてこわしながら\n　　ピーチを下までたどりつかせましょう！\n　　　　　　スタートしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）\n"
  },
  {
    "index": 24,
    "key": "000E92D4_0024",
    "original": "　　　タッチペンで　あしばをのばして\n　　　　ピーチをジャンプさせ　上を\n　　　　　　めざしましょう！\n　　　　　　スキップしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）",
    "translation": "　　　タッチペンで　あしばをのばして\n　　　　ピーチをジャンプさせ　上を\n　　　　　　めざしましょう！\n　　　　　　スキップしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）"
  },
  {
    "index": 25,
    "key": "000E92D4_0025",
    "original": "　　タッチペンであしばを回し　ピーチが\n　　　しょうがいぶつにあたらないように\n　　　　　上を　めざしましょう！\n　　　　　　スキップしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）",
    "translation": "　　タッチペンであしばを回し　ピーチが\n　　　しょうがいぶつにあたらないように\n　　　　　上を　めざしましょう！\n　　　　　　スキップしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）"
  },
  {
    "index": 26,
    "key": "000E92D4_0026",
    "original": "　　タッチペンで　下がめんにあらわれる\n　　テレサをこすってけしながら　ピーチを\n　　下まで　たどりつかせましょう！\n　　　　　　スキップしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）",
    "translation": "　　タッチペンで　下がめんにあらわれる\n　　テレサをこすってけしながら　ピーチを\n　　下まで　たどりつかせましょう！\n　　　　　　スキップしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）"
  },
  {
    "index": 27,
    "key": "000E92D4_0027",
    "original": "　　タッチペンで　下がめんにあらわれる\n　　しょうがいぶつをたたいてこわしながら\n　　ピーチを下までたどりつかせましょう！\n　　　　　　スキップしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）",
    "translation": "　　タッチペンで　下がめんにあらわれる\n　　しょうがいぶつをたたいてこわしながら\n　　ピーチを下までたどりつかせましょう！\n　　　　　　スキップしますか？\n　（Ａボタン『はい』　Ｂボタン『いいえ』）"
  },
  {
    "index": 28,
    "key": "000E92D4_0028",
    "original": "ビーチといえば　すなはま！\nかわいい　あの子とつくった\nすなの山！\n[1:000300][1:000100]\nいじわるな　なみが　ひとナツの\n思い出といっしょに　さらって\nいったカサー\n[1:000300][1:000100]\nせつないカサー・・\nすなに『水』かけちゃ\nだめカサー・・シクシク\n",
    "translation": "ビーチといえば　すなはま！\nかわいい　あの子とつくった\nすなの山！\n[1:000300][1:000100]\nいじわるな　なみが　ひとナツの\n思い出といっしょに　さらって\nいったカサー\n[1:000300][1:000100]\nせつないカサー・・\nすなに『水』かけちゃ\nだめカサー・・シクシク\n"
  },
  {
    "index": 29,
    "key": "000E92D4_0029",
    "original": "ううう・・・さむいカサー！\nゆかに『水』をまきちらしたら\nあっというまに\nこおってしまいそうだカサー\n",
    "translation": "ううう・・・さむいカサー！\nゆかに『水』をまきちらしたら\nあっというまに\nこおってしまいそうだカサー\n"
  },
  {
    "index": 30,
    "key": "000E92D4_0030",
    "original": "　　　　　　つづけますか？\n　　　　　はい　　　　いいえ",
    "translation": "　　　　　　つづけますか？\n　　　　　はい　　　　いいえ"
  },
  {
    "index": 31,
    "key": "000E92D4_0031",
    "original": "え？　へんな\nてっきゅうは\nどうするのかって？\n[1:000300][1:000100]\nそういうときは　すんごい\nはやいダッシュで\nてっきゅうに\nぶちあたってみるカサー！\n",
    "translation": "え？　へんな\nてっきゅうは\nどうするのかって？\n[1:000300][1:000100]\nそういうときは　すんごい\nはやいダッシュで\nてっきゅうに\nぶちあたってみるカサー！\n"
  },
  {
