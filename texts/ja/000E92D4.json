  {
    "index": 40,
    "key": "000E92D4_0040",
    "original": "[20:000a01ff]\n[20:0012]\n[1:000f00]\n[20:001406]\n[20:000d80ff00][1:000264]\n　キノピオを助けたよ！\n[1:000278]\n[1:0005]\n[20:000a00ff]\n[20:0012]\n[1:001000]\n[20:0003]\n",
    "translation": "[20:000a01ff]\n[20:0012]\n[1:000f00]\n[20:001406]\n[20:000d80ff00][1:000264]\n　キノピオを助けたよ！\n[1:000278]\n[1:0005]\n[20:000a00ff]\n[20:0012]\n[1:001000]\n[20:0003]\n"
  },
  {
    "index": 41,
    "key": "000E92D4_0041",
    "original": "このむこうに　でっけえ\nしょくぶつがいるカサー\nはいてくる　ちっこい\nヤツにちゅういしながら・・\n[1:000300][1:000100]\n口をひらいているときに\n『水』かなにか　ガブガブ\nのませてやれカサー！\nじゃくてんは・・うーん\nやけにでっけえ　でべそ・・？\n",
    "translation": "このむこうに　でっけえ\nしょくぶつがいるカサー\nはいてくる　ちっこい\nヤツにちゅういしながら・・\n[1:000300][1:000100]\n口をひらいているときに\n『水』かなにか　ガブガブ\nのませてやれカサー！\nじゃくてんは・・うーん\nやけにでっけえ　でべそ・・？\n"
  },
  {
    "index": 42,
    "key": "000E92D4_0042",
    "original": "このむこうに　ここの\nヌシの　ふくろうがいるカサー\nきゅうこうかしてきたところに\nあたまをねらって\nふんでやれカサー！\n[1:000300][1:000100]\nくうちゅうせんでは\nヤツがゆうり？\nこちらも　『喜』じょうたいで\nヤツよりたかく\nとびあがって・・\n[1:000300][1:000100]\nヤツの上におちるように\n『喜』じょうたいを\nかいじょして　ふんでやれカサ！\n",
    "translation": "このむこうに　ここの\nヌシの　ふくろうがいるカサー\nきゅうこうかしてきたところに\nあたまをねらって\nふんでやれカサー！\n[1:000300][1:000100]\nくうちゅうせんでは\nヤツがゆうり？\nこちらも　『喜』じょうたいで\nヤツよりたかく\nとびあがって・・\n[1:000300][1:000100]\nヤツの上におちるように\n『喜』じょうたいを\nかいじょして　ふんでやれカサ！\n"
  },
  {
    "index": 43,
    "key": "000E92D4_0043",
    "original": "このむこうに\nでっけえ　おばけがいるカサー\nおばけといえば\nひかりによわい？\n[1:000300][1:000100]\nなんとかして　へやの\n中を　あかるくするカサー！\nシャンデリアも\nたたきまくれば\nこわせそう・・\n",
    "translation": "このむこうに\nでっけえ　おばけがいるカサー\nおばけといえば\nひかりによわい？\n[1:000300][1:000100]\nなんとかして　へやの\n中を　あかるくするカサー！\nシャンデリアも\nたたきまくれば\nこわせそう・・\n"
  },
  {
    "index": 44,
    "key": "000E92D4_0044",
    "original": "このむこうにでっけえ\nイモムシがいるカサー\n『怒』りながら　じめんの\nへんなバネに　おもい\nたいじゅうでもかければ・・\n[1:000300][1:000100]\nあとは\nひっくりかえった　ところで\nじゃくてんを　ふんづけて\nやれカサー！\n[1:000300][1:000100]\nくさいけむりは　ほうっておくと\nダメージをうけるカサ！\n『たつまき』でふきけせる・・？\n",
    "translation": "このむこうにでっけえ\nイモムシがいるカサー\n『怒』りながら　じめんの\nへんなバネに　おもい\nたいじゅうでもかければ・・\n[1:000300][1:000100]\nあとは\nひっくりかえった　ところで\nじゃくてんを　ふんづけて\nやれカサー！\n[1:000300][1:000100]\nくさいけむりは　ほうっておくと\nダメージをうけるカサ！\n『たつまき』でふきけせる・・？\n"
  },
  {
    "index": 45,
    "key": "000E92D4_0045",
    "original": "このむこうに　でっけえ\nイカがいるカサー\nあしを　ぜんぶやっつけたら\n口にアタック！\n[1:000300][1:000100]\nスミは　『水』かなにかで\nそうじそうじ！\nねむりだしたら　いそいで\nはなちょうちん\nこわしておこせカサー！\n",
    "translation": "このむこうに　でっけえ\nイカがいるカサー\nあしを　ぜんぶやっつけたら\n口にアタック！\n[1:000300][1:000100]\nスミは　『水』かなにかで\nそうじそうじ！\nねむりだしたら　いそいで\nはなちょうちん\nこわしておこせカサー！\n"
  },
  {
    "index": 46,
    "key": "000E92D4_0046",
    "original": "このむこうに　ここのヌシの\nドラゴンがいるカサー\nヤツは　かたい氷で\nおおわれているから・・\n[1:000300][1:000100]\nふつうのこうげきは\nきかないカサ・・\n氷に　きくものといえば・・？\n",
    "translation": "このむこうに　ここのヌシの\nドラゴンがいるカサー\nヤツは　かたい氷で\nおおわれているから・・\n[1:000300][1:000100]\nふつうのこうげきは\nきかないカサ・・\n氷に　きくものといえば・・？\n"
  },
  {
    "index": 47,
    "key": "000E92D4_0047",
    "original": "このむこうに　でっけえ\nまほうつかいがいるカサー\nヤツは　かぜによわいから\n『たつまき』か　なにかを\nあたまにあてて・・\n[1:000300][1:000100]\n目をまわしたときが\nチャンスだカサー！\nオイラは　まほうつかいが\nだいきらいカサー！！（怒）\n",
    "translation": "このむこうに　でっけえ\nまほうつかいがいるカサー\nヤツは　かぜによわいから\n『たつまき』か　なにかを\nあたまにあてて・・\n[1:000300][1:000100]\n目をまわしたときが\nチャンスだカサー！\nオイラは　まほうつかいが\nだいきらいカサー！！（怒）\n"
  },
  {
    "index": 48,
    "key": "000E92D4_0048",
    "original": "ついに　ここまできたカサー！\nハンマーのヤツは\nうごきがはやいカサー！\nさきに　じゃまなザコを\nかたづけるカサー！\n[1:000300][1:000100]\nクッパは・・うーん\nでっけえ　かおがじゃくてん？\nとにかく　かおをねらえカサー\n使えそうなモノは　なんでも\nりようしてやれカサー",
    "translation": "ついに　ここまできたカサー！\nハンマーのヤツは\nうごきがはやいカサー！\nさきに　じゃまなザコを\nかたづけるカサー！\n[1:000300][1:000100]\nクッパは・・うーん\nでっけえ　かおがじゃくてん？\nとにかく　かおをねらえカサー\n使えそうなモノは　なんでも\nりようしてやれカサー"
  },
