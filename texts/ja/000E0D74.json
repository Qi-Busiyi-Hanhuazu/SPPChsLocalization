  {
    "index": 41,
    "key": "000E0D74_0041",
    "original": "[1:00110000000008][1:00110100000004]\nほんとですね・・・[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004]\nほんとですね・・・[1:0002b4]\n[1:000101]"
  },
  {
