    "translation": "[1:00110000000000][1:00110100000000]\n[1:00110300000001]\n[1:000101]",
    "trash": true
  },
  {
    "index": 35,
    "key": "000E0D74_0035",
    "original": "[1:00110000000008][1:00110100000004]\nクッパさま！　やりました！\nついに　あのマリオを\nつかまえました！[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004]\nクッパさま！　やりました！\nついに　あのマリオを\nつかまえました！[1:0002b4]\n[1:000101]"
  },
  {
    "index": 36,
    "key": "000E0D74_0036",
    "original": "[1:00110000000007][1:00110100000004]\n[1:00110300000008]\nおおお！　よくやった！\nついに　とらえよったか！[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000007][1:00110100000004]\n[1:00110300000008]\nおおお！　よくやった！\nついに　とらえよったか！[1:0002b4]\n[1:000101]"
  },
  {
    "index": 37,
    "key": "000E0D74_0037",
    "original": "[1:00110000000008][1:00110100000004]\nヘイ！　緑のオッサンと\nキノコあたまの　うるさい\nガキも　ついでにとらえて・・[1:0002b4]\n[1:000101]\n",
    "translation": "[1:00110000000008][1:00110100000004]\nヘイ！　緑のオッサンと\nキノコあたまの　うるさい\nガキも　ついでにとらえて・・[1:0002b4]\n[1:000101]\n"
  },
  {
    "index": 38,
    "key": "000E0D74_0038",
    "original": "[1:00110000000008][1:00110100000004]\n子分たちに見はらせて\nおります[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004]\n子分たちに見はらせて\nおります[1:0002b4]\n[1:000101]"
  },
  {
    "index": 39,
    "key": "000E0D74_0039",
    "original": "[1:00110000000007][1:00110100000004]\nよしよし・・それにしても\nあのつえは　おそろしい\nものよのう・・[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000007][1:00110100000004]\nよしよし・・それにしても\nあのつえは　おそろしい\nものよのう・・[1:0002b4]\n[1:000101]"
  },
  {
    "index": 40,
    "key": "000E0D74_0040",
    "original": "[1:00110000000007][1:00110100000004]\nいったい　どんなチカラが\nふうじこめられてあるのか・・[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000007][1:00110100000004]\nいったい　どんなチカラが\nふうじこめられてあるのか・・[1:0002b4]\n[1:000101]"
