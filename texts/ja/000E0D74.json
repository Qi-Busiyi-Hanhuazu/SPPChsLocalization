  {
    "index": 31,
    "key": "000E0D74_0031",
    "original": "[1:00110000000008][1:00110100000002]\nやったー！　ついにあの\nにっくきマリオを\nつかまえたぞー！！[1:0002b4]\n[1:001105ffffffde]\n[1:000101]\n",
    "translation": "[1:00110000000008][1:00110100000002]\nやったー！　ついにあの\nにっくきマリオを\nつかまえたぞー！！[1:0002b4]\n[1:001105ffffffde]\n[1:000101]\n"
  },
  {
    "index": 32,
    "key": "000E0D74_0032",
    "original": "[1:00110000000009][1:00110100000002]\nこっちもやりましたよ！\nたいちょー！[1:0002b4]\n[1:001104ffffffe8]\n[1:00110500000010]\n[1:000101]",
    "translation": "[1:00110000000009][1:00110100000002]\nこっちもやりましたよ！\nたいちょー！[1:0002b4]\n[1:001104ffffffe8]\n[1:00110500000010]\n[1:000101]"
  },
  {
    "index": 33,
    "key": "000E0D74_0033",
    "original": "[1:00110000000008][1:00110100000002]\nよーし！　ではひきあげるぞ！\nヤロウども！[1:0002b4]\n[1:00110200000001]",
    "translation": "[1:00110000000008][1:00110100000002]\nよーし！　ではひきあげるぞ！\nヤロウども！[1:0002b4]\n[1:00110200000001]"
  },
