[
  {
    "index": 0,
    "key": "000E0D74_0000",
    "original": "[1:00110000000001][1:00110100000008]\nここは　フシギの島\n『キド・アイラック島』[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000001][1:00110100000008]\nここは　フシギの島\n『キド・アイラック島』[1:0002b4]\n[1:000101]"
  },
  {
    "index": 1,
    "key": "000E0D74_0001",
    "original": "[1:00110000000001][1:00110100000008]\nキノコ王国から　少しはなれた \nばしょにある　この島には・・\nあやしげなチカラをもつ[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000001][1:00110100000008]\nキノコ王国から　少しはなれた \nばしょにある　この島には・・\nあやしげなチカラをもつ[1:0002b4]\n[1:000101]"
  },
  {
    "index": 2,
    "key": "000E0D74_0002",
    "original": "[1:00110000000001][1:00110100000008]\n『キド・アイラックのつえ』が\nあるという　うわさがありました[1:0002b4]\n[1:00110200000001][1:000101]",
    "translation": "[1:00110000000001][1:00110100000008]\n『キド・アイラックのつえ』が\nあるという　うわさがありました[1:0002b4]\n[1:00110200000001][1:000101]"
  },
  {
    "index": 3,
    "key": "000E0D74_0003",
    "original": "[1:00110000000001][1:00110100000009]\nうわさをききつけた　クッパは\nこの地に　別荘として城をたて・・\n[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000001][1:00110100000009]\nうわさをききつけた　クッパは\nこの地に　別荘として城をたて・・\n[1:0002b4]\n[1:000101]"
  },
  {
    "index": 4,
    "key": "000E0D74_0004",
    "original": "[1:00110000000001][1:00110100000009]\nマリオたちに　わるさをするため\nあやしげなチカラをもつ　その\nつえを　さがしていました・・[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000001][1:00110100000009]\nマリオたちに　わるさをするため\nあやしげなチカラをもつ　その\nつえを　さがしていました・・[1:0002b4]\n[1:000101]"
  },
  {
    "index": 5,
    "key": "000E0D74_0005",
    "original": "[1:00110000000000][1:00110100000000]\n[1:001105ffffffe0]\n[1:000101]",
    "translation": "[1:00110000000000][1:00110100000000]\n[1:001105ffffffe0]\n[1:000101]",
    "trash": true
  },
  {
    "index": 6,
    "key": "000E0D74_0006",
    "original": "[1:00110000000008][1:00110100000001]\n[1:00110300000008]\nクッパさま！　クッパさまぁーーー！[1:0002b4]\n[1:00110300000001]\n[1:000296]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000001]\n[1:00110300000008]\nクッパさま！　クッパさまぁーーー！[1:0002b4]\n[1:00110300000001]\n[1:000296]\n[1:000101]"
  },
  {
    "index": 7,
    "key": "000E0D74_0007",
    "original": "[1:00110000000008][1:00110100000004]\nやりましたよ！\nついに見つけました！\n『キド・アイラックのつえ』っス！[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004]\nやりましたよ！\nついに見つけました！\n『キド・アイラックのつえ』っス！[1:0002b4]\n[1:000101]"
  },
  {
    "index": 8,
    "key": "000E0D74_0008",
    "original": "[1:00110000000007][1:00110100000004]\nなに？　ほんとうか？\nよーし　でかしたぞ！[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000007][1:00110100000004]\nなに？　ほんとうか？\nよーし　でかしたぞ！[1:0002b4]\n[1:000101]"
  },
  {
    "index": 9,
    "key": "000E0D74_0009",
    "original": "[1:00110000000008][1:00110100000004][1:0011020000007a]\nこれで　やっとマリオたちに\nしかえしできますね！[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004][1:0011020000007a]\nこれで　やっとマリオたちに\nしかえしできますね！[1:0002b4]\n[1:000101]"
  },
  {
    "index": 10,
    "key": "000E0D74_0010",
    "original": "[1:00110000000007][1:00110100000004]\n[1:00110300000002]\nバ・・バカモン！\n声がでかいわ！[1:0002b4]\n[1:00110300000003]\n[1:000101]",
    "translation": "[1:00110000000007][1:00110100000004]\n[1:00110300000002]\nバ・・バカモン！\n声がでかいわ！[1:0002b4]\n[1:00110300000003]\n[1:000101]"
  },
  {
    "index": 11,
    "key": "000E0D74_0011",
    "original": "[1:00110000000008][1:00110100000004]\nす・・すいません・・\nつい　コーフンして\nしまって・・[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004]\nす・・すいません・・\nつい　コーフンして\nしまって・・[1:0002b4]\n[1:000101]"
  },
  {
    "index": 12,
    "key": "000E0D74_0012",
    "original": "[1:00110000000007][1:00110100000004]\nおい！　そこのお前！\nちょっと　前にあるトビラを\nしめてくれんか？[1:0002b4]\n[1:00110300000004]\n[1:00110300000005]\n[1:000101]",
    "translation": "[1:00110000000007][1:00110100000004]\nおい！　そこのお前！\nちょっと　前にあるトビラを\nしめてくれんか？[1:0002b4]\n[1:00110300000004]\n[1:00110300000005]\n[1:000101]"
  },
  {
    "index": 13,
    "key": "000E0D74_0013",
    "original": "[1:00110000000007][1:00110100000004]\nどこからじょうほうが\nもれるか　わからんからな・・[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000007][1:00110100000004]\nどこからじょうほうが\nもれるか　わからんからな・・[1:0002b4]\n[1:000101]"
  },
  {
    "index": 14,
    "key": "000E0D74_0014",
    "original": "[1:00110000000007][1:00110100000004]\n・・・さて・・・\nそのつえに　うわさどおりの\nあやしげなチカラがあれば・・[1:0002b4]\n[1:000101]\n",
    "translation": "[1:00110000000007][1:00110100000004]\n・・・さて・・・\nそのつえに　うわさどおりの\nあやしげなチカラがあれば・・[1:0002b4]\n[1:000101]\n"
  },
  {
    "index": 15,
    "key": "000E0D74_0015",
    "original": "[1:00110000000007][1:00110100000004]\n[1:0011030000000d]\nきっとマリオたちを\nコテンパンにできるはずだ\nガハハハハ！[1:0002b4]\n[1:000101]\n",
    "translation": "[1:00110000000007][1:00110100000004]\n[1:0011030000000d]\nきっとマリオたちを\nコテンパンにできるはずだ\nガハハハハ！[1:0002b4]\n[1:000101]\n"
  },
  {
    "index": 16,
    "key": "000E0D74_0016",
    "original": "[1:00110000000008][1:00110100000004]\nハハーッ！　さっそくやつらの所に\nのりこんで　つえのチカラを\nためしてまいりますっ！[1:0002b4]\n[1:00110300000006]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004]\nハハーッ！　さっそくやつらの所に\nのりこんで　つえのチカラを\nためしてまいりますっ！[1:0002b4]\n[1:00110300000006]\n[1:000101]"
  },
  {
    "index": 17,
    "key": "000E0D74_0017",
    "original": "[1:00110000000008][1:00110100000004]\nおいっ！　そこのクリボー！\nちょっとこっちにこい[1:0002b4]\n[1:00110300000007]\n[1:000296]\n[1:00110300000009]\n[1:000296]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004]\nおいっ！　そこのクリボー！\nちょっとこっちにこい[1:0002b4]\n[1:00110300000007]\n[1:000296]\n[1:00110300000009]\n[1:000296]\n[1:000101]"
  },
  {
    "index": 18,
    "key": "000E0D74_0018",
    "original": "[1:00110000000008][1:00110100000004]\nほれ！　お前がキノコ王国に\nしのびこんで　このつえを\nふりかざしてこい[1:0002b4]\n[1:0011030000000a]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004]\nほれ！　お前がキノコ王国に\nしのびこんで　このつえを\nふりかざしてこい[1:0002b4]\n[1:0011030000000a]\n[1:000101]"
  },
  {
    "index": 19,
    "key": "000E0D74_0019",
    "original": "[1:00110000000008][1:00110100000004]\n元　キノコ王国の住人である\nお前なら　やつらに\n気づかれにくいはずだ・・[1:0002b4]\n[1:000101]",
    "translation": "[1:00110000000008][1:00110100000004]\n元　キノコ王国の住人である\nお前なら　やつらに\n気づかれにくいはずだ・・[1:0002b4]\n[1:000101]"
  },
  {
    "index": 20,
    "key": "000E0D74_0020",
    "original": "[1:00110000000008][1:00110100000004]\n[1:0011030000000b]\nよーし！　行くぞヤロウども！\nこのつえで　マリオたちを\nコテンパンにしに行くんだ！[1:0002b4]\n[1:000101]\n[1:0011030000000c]\n",
    "translation": "[1:00110000000008][1:00110100000004]\n[1:0011030000000b]\nよーし！　行くぞヤロウども！\nこのつえで　マリオたちを\nコテンパンにしに行くんだ！[1:0002b4]\n[1:000101]\n[1:0011030000000c]\n"
  },
  {
